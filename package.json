{
  "name": "pagi-shopify",
  "version": "1.0.0",
  "description": "Shopify theme, two Functions and an ops backend for a brunch café that takes pickup and delivery orders",
  "scripts": {
    "theme:dev": "shopify theme dev --path theme",
    "theme:check": "shopify theme check --path theme",
    "preview": "node preview/server.mjs",
    "e2e": "node preview/e2e.mjs",
    "images": "node design/build.mjs",
    "seed": "node scripts/seed.js",
    "test": "node --test \"lib/test/*.test.js\" \"scripts/test/*.test.js\" \"extensions/*/test/*.test.js\" && npm --prefix ops test",
    "web": "node preview/web-build.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@shopify/cli": "^4.9.4",
    "esbuild": "^0.28.2",
    "liquidjs": "^10.30.0",
    "puppeteer-core": "^25.16.0"
  },
  "private": true
}
