<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="d-hero">{{ section.settings.heading | escape }}</h1>
      <p class="lead">{{ section.settings.text | escape }}</p>
      <div class="cluster hero__actions">
        <a href="{{ section.settings.cta_link }}" class="btn btn--lg">{{ section.settings.cta | escape }}</a>
        {%- if section.settings.cta2 != blank -%}<a href="{{ section.settings.cta2_link }}" class="btn btn--lg btn--ghost">{{ section.settings.cta2 | escape }}</a>{%- endif -%}
      </div>
      <dl class="facts">
        <div><dt>{{ 'footer.hours' | t }}</dt><dd>{{ settings.hours_open }}–{{ settings.hours_close }}</dd></div>
        <div><dt>{{ 'cart.pickup' | t }}</dt><dd>{{ section.settings.ready_hint | escape }}</dd></div>
        <div><dt>{{ 'cart.delivery' | t }}</dt><dd>{{ 'cart.delivery_sub' | t }}</dd></div>
      </dl>
    </div>
    <div class="hero__art">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '450, 700, 900, 1200', sizes: '(min-width: 900px) 42vw, 100vw', preload: true, fetchpriority: 'high', alt: section.settings.image.alt }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pererenan, Bali" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Brunch, ready when you are" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta", "label": "Button", "default": "Order now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "cta2", "label": "Second button" },
    { "type": "url", "id": "cta2_link", "label": "Second button link" },
    { "type": "text", "id": "ready_hint", "label": "Pickup time hint", "default": "Ready in about 20 min" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
